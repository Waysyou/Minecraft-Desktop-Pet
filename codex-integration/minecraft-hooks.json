{
  "description": "Minecraft original native desktop pet: local status metadata only. Review before trusting.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "commandWindows": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "commandWindows": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "commandWindows": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "commandWindows": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "commandWindows": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "commandWindows": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "commandWindows": "G:/Desktop-Apps/codex-integration/MinecraftEventRelay.exe --hook",
            "timeout": 3
          }
        ]
      }
    ]
